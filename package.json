{
  "name": "nestjs-redis-client",
  "version": "1.0.0",
  "description": "A reusable NestJS module for Redis integration.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mouloud240/Nestjs-redis.git"
  },
  "bugs": {
    "url": "https://github.com/mouloud240/Nestjs-redis/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts  --out-dir dist --tsconfig tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "nestjs",
    "nestjs-module",
    "redis",
