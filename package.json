  ],
  "license": "MIT",
  
  "peerDependencies": {
    "@nestjs/common": "^9 || ^10 || ^11",
    "@nestjs/core": "^9 || ^10 || ^11"
  },
  "dependencies": {
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  }
}
