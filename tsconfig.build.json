{
"extends": "./tsconfig.json",
"compilerOptions": {
"outDir": "dist",
"declaration": true,
"declarationMap": true,
"emitDeclarationOnly": false,
"module": "CommonJS",
"target": "ES2019",
"rootDir": "src",
    "incremental": false,        
"strict": true,
"skipLibCheck": true
},
"include": ["src/**/*"],
"exclude": ["**/*.spec.ts", "test", "node_modules"]
}
